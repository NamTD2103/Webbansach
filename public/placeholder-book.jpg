<svg xmlns="http://www.w3.org/2000/svg" width="300" height="400" viewBox="0 0 300 400" fill="none">
  <!-- Background -->
  <rect width="300" height="400" fill="#f3f4f6"/>
  
  <!-- Book shape -->
  <g>
    <!-- Left page -->
    <rect x="40" y="100" width="110" height="200" fill="#e5e7eb" stroke="#9ca3af" stroke-width="2"/>
    
    <!-- Right page -->
    <rect x="150" y="100" width="110" height="200" fill="#f9fafb" stroke="#9ca3af" stroke-width="2"/>
    
    <!-- Spine -->
    <rect x="145" y="100" width="10" height="200" fill="#d1d5db"/>
    
    <!-- Book icon in center -->
    <g transform="translate(75, 120)">
      <!-- Top page fold -->
      <path d="M 60 0 L 85 0 L 75 15 L 50 15 Z" fill="#fca5a5"/>
      
      <!-- Book outline -->
      <path d="M 25 15 L 30 10 L 80 10 L 85 15 L 85 120 L 25 120 Z" fill="none" stroke="#7f1d1d" stroke-width="3" stroke-linejoin="round"/>
      
      <!-- Pages line -->
      <line x1="55" y1="20" x2="55" y2="115" stroke="#991b1b" stroke-width="2"/>
      
      <!-- Text lines -->
      <line x1="35" y1="40" x2="75" y2="40" stroke="#dc2626" stroke-width="1.5" opacity="0.6"/>
      <line x1="35" y1="55" x2="75" y2="55" stroke="#dc2626" stroke-width="1.5" opacity="0.6"/>
      <line x1="35" y1="70" x2="75" y2="70" stroke="#dc2626" stroke-width="1.5" opacity="0.6"/>
      <line x1="35" y1="85" x2="65" y2="85" stroke="#dc2626" stroke-width="1.5" opacity="0.6"/>
    </g>
  </g>
  
  <!-- Text label -->
  <text x="150" y="350" font-size="16" font-weight="bold" fill="#6b7280" text-anchor="middle">
    No Image Available
  </text>
</svg>